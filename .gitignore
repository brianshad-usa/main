# Social pipeline transient files (not committed)
pending.json
_card_preview.png

# Local/dev/test renders from content_studio.py. Real post slots are minted ONLY
# by the production GitHub Action (CONTENT_STUDIO_ENV=production); every other run
# writes here instead of the real social/ + editorial/manifests/ paths, so a test
# render can never collide with a production slot or be staged by git add -A.
scratch/
# Belt-and-suspenders: never commit a test-prefixed slot even if one is produced
# outside scratch/ by an older build.
social/test-*
editorial/manifests/test-*

# Python
__pycache__/
*.pyc

# Produced-video library (videos/library/).
# Kept on disk under videos/ per Brian's "produced videos live in videos/"
# preference, but deliberately NOT committed: the flagship master (88.7 MB) and
# the full-quality GBP cut (44 MB) each exceed Cloudflare Pages' hard 25 MiB
# per-file asset limit, and pushing them would fail the site deploy.
# Every video tracked in this repo is under 19 MB for exactly this reason.
# Side benefit: files that are never pushed can never trigger publish-video.yml.
videos/library/
