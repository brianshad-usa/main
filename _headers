/*
  Strict-Transport-Security: max-age=31536000

# ---- Static-asset caching (SEO engine, Core Web Vitals) -------------------
# HTML stays revalidated by Cloudflare; assets get sane TTLs. Filenames are not
# content-hashed, so CSS/JS use a 1-day TTL + stale-while-revalidate, media 30d.
/*.css
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/*.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/*.png
  Cache-Control: public, max-age=2592000
/*.jpg
  Cache-Control: public, max-age=2592000
/*.webp
  Cache-Control: public, max-age=2592000
/*.svg
  Cache-Control: public, max-age=2592000
/*.mp4
  Cache-Control: public, max-age=2592000
/*.woff2
  Cache-Control: public, max-age=31536000, immutable
